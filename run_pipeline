            "Without Subgroup": models_test_predictions["XGBoost_ECFP"]["Without Subgroup"]
        },
        "XGBoost_Descriptors": {
            "With Subgroup": models_test_predictions["XGBoost_Descriptors"]["With Subgroup"],
            "Without Subgroup": models_test_predictions["XGBoost_Descriptors"]["Without Subgroup"]
        },
        "RandomForest_ECFP": {
              "With Subgroup": models_test_predictions["RandomForest_ECFP"]["With Subgroup"],
              "Without Subgroup": models_test_predictions["RandomForest_ECFP"]["Without Subgroup"]
          },
          "RandomForest_Descriptors": {
