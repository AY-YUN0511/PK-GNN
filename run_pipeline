            "Without Subgroup": models_test_predictions["GaussianProcessRegressor_Descriptors"]["Without Subgroup"]

        }
    }

    # Calculate metrics for all models
    metrics_list = []

    for model_name, subgroups in models.items():
        for category, preds in subgroups.items():
            if preds is not None:
                metrics = compute_metrics(y_test, preds)
                metrics['Model'] = model_name
                metrics['Category'] = category
                metrics_list.append(metrics)

    # Create a DataFrame from the metrics list
    metrics_df = pd.DataFrame(metrics_list)
    metrics_df = metrics_df[["Model", "Category", "R2 (log)", "RMSE (log)", "MAE (log)", 
                             "Accuracy_within_2x (%)", "Accuracy_within_3x (%)", "Accuracy_within_4x (%)"]]

    # Display the metrics table using tabulate
    print_metrics_table(metrics_df)

    # Export the metrics table to CSV and LaTeX
    save_metrics(metrics_df, SAVE_DIR)

    # Plot R² Comparison
    plot_r2_comparison(metrics_df, SAVE_DIR)

    # Plot RMSE Comparison
    plot_rmse_comparison(metrics_df, SAVE_DIR)

    # Plot Additional Metrics
    plot_additional_metrics(metrics_df, SAVE_DIR)

    # Save the prediction dictionaries
    predictions_paths = {
        'models_val_predictions.pkl': models_val_predictions,
        'models_test_predictions.pkl': models_test_predictions,
        'y_val.pkl': y_val,
        'y_test.pkl': y_test
    }

    for filename, data in predictions_paths.items():
        save_path = os.path.join(SAVE_DIR, filename)
        save_predictions(data, save_path)

