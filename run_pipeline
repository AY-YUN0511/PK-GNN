        models_test_predictions["RandomForest_Descriptors"]["With Subgroup"],
        models_test_predictions["SVR_Descriptors"]["With Subgroup"],
        models_test_predictions["ElasticNet_Descriptors"]["With Subgroup"],
        models_test_predictions["MLPRegressor_Descriptors"]["With Subgroup"],
        models_test_predictions["GaussianProcessRegressor_Descriptors"]["With Subgroup"]
    ]

    predictions_ecfp_no_subgroup = [
        models_test_predictions["XGBoost_ECFP"]["Without Subgroup"],
        models_test_predictions["CatBoost_ECFP"]["Without Subgroup"],
        models_test_predictions["RandomForest_ECFP"]["Without Subgroup"],
        models_test_predictions["SVR_ECFP"]["Without Subgroup"],
        models_test_predictions["ElasticNet_ECFP"]["Without Subgroup"],
        models_test_predictions["MLPRegressor_ECFP"]["Without Subgroup"],
        models_test_predictions["GaussianProcessRegressor_ECFP"]["Without Subgroup"]
    ]

    predictions_desc_no_subgroup = [
        models_test_predictions["XGBoost_Descriptors"]["Without Subgroup"],
        models_test_predictions["CatBoost_Descriptors"]["Without Subgroup"],
        models_test_predictions["RandomForest_Descriptors"]["Without Subgroup"],
        models_test_predictions["SVR_Descriptors"]["Without Subgroup"],
        models_test_predictions["ElasticNet_Descriptors"]["Without Subgroup"],
        models_test_predictions["MLPRegressor_Descriptors"]["Without Subgroup"],
        models_test_predictions["GaussianProcessRegressor_Descriptors"]["Without Subgroup"]
    ]

    # Define Weights for Each Ensemble (equal weights)
    weight_ecfp = 1.0 / len(predictions_ecfp_with_subgroup)
    weight_desc = 1.0 / len(predictions_desc_with_subgroup)

    # Apply Weighted Average Ensemble
    ensemble_ecfp_with_subgroup = np.sum([weight_ecfp * preds for preds in predictions_ecfp_with_subgroup], axis=0)
    r2_ensemble_ecfp_with_subgroup = r2_score(y_test, ensemble_ecfp_with_subgroup)
    print(f"\nEnsemble ECFP with Subgroup R² on test set: {r2_ensemble_ecfp_with_subgroup:.4f}")

    ensemble_desc_with_subgroup = np.sum([weight_desc * preds for preds in predictions_desc_with_subgroup], axis=0)
    r2_ensemble_desc_with_subgroup = r2_score(y_test, ensemble_desc_with_subgroup)
    print(f"Ensemble Descriptors with Subgroup R² on test set: {r2_ensemble_desc_with_subgroup:.4f}")

    ensemble_ecfp_no_subgroup = np.sum([weight_ecfp * preds for preds in predictions_ecfp_no_subgroup], axis=0)
    r2_ensemble_ecfp_no_subgroup = r2_score(y_test, ensemble_ecfp_no_subgroup)
    print(f"Ensemble ECFP without Subgroup R² on test set: {r2_ensemble_ecfp_no_subgroup:.4f}")

    ensemble_desc_no_subgroup = np.sum([weight_desc * preds for preds in predictions_desc_no_subgroup], axis=0)
    r2_ensemble_desc_no_subgroup = r2_score(y_test, ensemble_desc_no_subgroup)
    print(f"Ensemble Descriptors without Subgroup R² on test set: {r2_ensemble_desc_no_subgroup:.4f}")

    # Define dictionary of models with their corresponding predictions
    models = {
        "XGBoost_ECFP": {
