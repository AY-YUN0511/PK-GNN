import os
import pickle
import numpy as np
import pandas as pd
from src.config import SEED, N_TRIALS, SAVE_DIR, FEATURE_TYPES, SUBGROUP_OPTIONS, TARGET
from src.data_preprocessing import set_seed, load_and_preprocess_data
from src.features import compute_ecfp_fingerprints, compute_and_scale_descriptors, generate_ecfp_feature_names
from src.training import tune_and_train_models
from src.evaluation import compute_metrics
from src.utils import save_predictions, save_metrics
from src.plot_utils import print_metrics_table, plot_r2_comparison, plot_rmse_comparison, plot_additional_metrics

def main():
    
    # Create save directory if it doesn't exist
    os.makedirs(SAVE_DIR, exist_ok=True)
    print(f"Files will be saved to: {SAVE_DIR}")

    # Load and preprocess data
    train_df, val_df, test_df, scaler = load_and_preprocess_data(os.path.join('data', 'raw', 'processed_data.csv'))

    # Assign initial subgroups
    train_df['subgroup'] = train_df['human VDss (L/kg)'].apply(lambda x: 0 if x < 0.5 else (1 if 0.5 <= x < 1.7 else 2))
    val_df['subgroup'] = np.nan
    test_df['subgroup'] = np.nan

    # Combine datasets for label propagation
    combined_df = pd.concat([train_df, val_df, test_df], ignore_index=True)
    combined_df.loc[:len(train_df) - 1, 'subgroup'] = train_df['subgroup'].values

    # Extract features and labels
    X_combined = combined_df[FEATURE_TYPES]
    y_combined = combined_df['subgroup'].fillna(-1)  # Unlabeled data as -1

    # Label Propagation
    from sklearn.semi_supervised import LabelPropagation
    label_spread = LabelPropagation(kernel='rbf', gamma=0.9, max_iter=20, n_neighbors=20)
    label_spread.fit(X_combined, y_combined)

    combined_df['spread_subgroup'] = label_spread.predict(X_combined)

    # Create binary subgroup columns
    for i in range(label_spread.classes_.shape[0]):
        combined_df[f'subgroup{i+1}'] = (combined_df['spread_subgroup'] == i).astype(int)

    # Split back into train, val, test
    train_len = len(train_df)
    val_len = len(val_df)
    test_len = len(test_df)

    train_df['subgroup'] = combined_df.iloc[:train_len]['spread_subgroup'].values
    val_df['subgroup'] = combined_df.iloc[train_len:train_len + val_len]['spread_subgroup'].values
    test_df['subgroup'] = combined_df.iloc[train_len + val_len:train_len + val_len + test_len]['spread_subgroup'].values

    for i in range(label_spread.classes_.shape[0]):
        train_df[f'subgroup{i+1}'] = combined_df.iloc[:train_len][f'subgroup{i+1}'].values
        val_df[f'subgroup{i+1}'] = combined_df.iloc[train_len:train_len + val_len][f'subgroup{i+1}'].values
        test_df[f'subgroup{i+1}'] = combined_df.iloc[train_len + val_len:train_len + val_len + test_len][f'subgroup{i+1}'].values

    # Compute ECFP and Descriptor features
    train_ecfp = compute_ecfp_fingerprints(train_df)
    val_ecfp = compute_ecfp_fingerprints(val_df)
    test_ecfp = compute_ecfp_fingerprints(test_df)

    train_desc = compute_and_scale_descriptors(train_df, fit_scaler=True)
    val_desc = compute_and_scale_descriptors(val_df, scaler=train_desc['scaler'])
    test_desc = compute_and_scale_descriptors(test_df, scaler=train_desc['scaler'])

    # Prepare feature names
    num_ecfp_features = train_ecfp['ecfp_features'].shape[1]
    ecfp_feature_names = generate_ecfp_feature_names(num_ecfp_features) + ['Subgroup1', 'Subgroup2', 'Subgroup3']
    descriptor_names = list(train_desc['descriptor_names']) + ['Subgroup1', 'Subgroup2', 'Subgroup3']

    print(f"ECFP Feature Name Length: {len(ecfp_feature_names)}")
    print(f"Descriptor Feature Name Length: {len(descriptor_names)}")

    # Define target variable
    y_train = train_df[TARGET].values
    y_val = val_df[TARGET].values
    y_test = test_df[TARGET].values

    # Hyperparameter tuning and model training
    best_models, models_test_predictions, models_val_predictions = tune_and_train_models(
        train_df, val_df, test_df, train_ecfp, val_ecfp, test_ecfp, train_desc, val_desc, test_desc, target=TARGET
    )

    # Collect all predictions into a single dictionary
    predictions_ecfp_with_subgroup = [
        models_test_predictions["XGBoost_ECFP"]["With Subgroup"],
        models_test_predictions["CatBoost_ECFP"]["With Subgroup"],
        models_test_predictions["RandomForest_ECFP"]["With Subgroup"],
        models_test_predictions["SVR_ECFP"]["With Subgroup"],
        models_test_predictions["ElasticNet_ECFP"]["With Subgroup"],
        models_test_predictions["MLPRegressor_ECFP"]["With Subgroup"],
        models_test_predictions["GaussianProcessRegressor_ECFP"]["With Subgroup"]
    ]

    predictions_desc_with_subgroup = [
        models_test_predictions["XGBoost_Descriptors"]["With Subgroup"],
