          },
    
    
        "CatBoost_ECFP": {
            "With Subgroup": models_test_predictions["CatBoost_ECFP"]["With Subgroup"],
            "Without Subgroup": models_test_predictions["CatBoost_ECFP"]["Without Subgroup"]
        },
        "CatBoost_Descriptors": {
            "With Subgroup": models_test_predictions["CatBoost_Descriptors"]["With Subgroup"],
            "Without Subgroup": models_test_predictions["CatBoost_Descriptors"]["Without Subgroup"]
        },
        "SVR_ECFP": {
            "With Subgroup": models_test_predictions["SVR_ECFP"]["With Subgroup"],
            "Without Subgroup": models_test_predictions["SVR_ECFP"]["Without Subgroup"]
        },
        "SVR_Descriptors": {
            "With Subgroup": models_test_predictions["SVR_Descriptors"]["With Subgroup"],
            "Without Subgroup": models_test_predictions["SVR_Descriptors"]["Without Subgroup"]
        },
        "ElasticNet_ECFP": {
            "With Subgroup": models_test_predictions["ElasticNet_ECFP"]["With Subgroup"],
            "Without Subgroup": models_test_predictions["ElasticNet_ECFP"]["Without Subgroup"]
        },
        "ElasticNet_Descriptors": {
            "With Subgroup": models_test_predictions["ElasticNet_Descriptors"]["With Subgroup"],
            "Without Subgroup": models_test_predictions["ElasticNet_Descriptors"]["Without Subgroup"]
        },
        "MLPRegressor_ECFP": {
            "With Subgroup": models_test_predictions["MLPRegressor_ECFP"]["With Subgroup"],
            "Without Subgroup": models_test_predictions["MLPRegressor_ECFP"]["Without Subgroup"]
        },
        "MLPRegressor_Descriptors": {
            "With Subgroup": models_test_predictions["MLPRegressor_Descriptors"]["With Subgroup"],
            "Without Subgroup": models_test_predictions["MLPRegressor_Descriptors"]["Without Subgroup"]
        },
        "GaussianProcessRegressor_ECFP": {
            "With Subgroup": models_test_predictions["GaussianProcessRegressor_ECFP"]["With Subgroup"],
            "Without Subgroup": models_test_predictions["GaussianProcessRegressor_ECFP"]["Without Subgroup"]
        },
        "GaussianProcessRegressor_Descriptors": {
